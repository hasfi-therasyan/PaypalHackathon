# PayPal — Sandbox credentials only
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Supabase — service role is server-only and required for private proof uploads
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Services
MODEL_SERVICE_URL=https://stake-model.vercel.app
# Optional only if a paid/external vision service is added later. The default
# photo-proof flow uses free on-device object detection and a final
# friend-referee decision.
VISION_REFEREE_URL=
VISION_REFEREE_API_KEY=

# Operations
CRON_SECRET=
# Stake amounts have no application-level maximum.
DEMO_MODE=false
